programa {
  funcao inicio() {
    inteiro numerodePessoas
    cadeia ok
    escreva("a conta deu 200 reais")
    leia("cadeia")
    escreva("vamos dividir em quantas pessoas")
    leia(numerodePessoas)
    escreva( " a conta vai ficar "  , 200 / numerodePessoas, " reais por pessoas " ) 
    

   
    }
 }
