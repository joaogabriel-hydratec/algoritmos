programa {
  funcao inicio() {
    inteiro idade
    escreva("digite sua idade")
    leia (idade)
    se (idade >= 12) {
      escreva("infantil")
     }senao se (idade >= 17) {
      escreva ("juvenil")
     }senao se (idade <= 18) {
      escreva ("adulto")
     }
       }
  }

