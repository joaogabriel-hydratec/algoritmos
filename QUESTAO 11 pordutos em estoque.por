programa {
  funcao inicio() {
    inteiro numerodeProdutos 

    escreva("quantos voce deseja comprar?")
    leia (numerodeProdutos)
    se(numerodeProdutos <= 50) {
      escreva ("estoque adequado")
    } senao se (numerodeProdutos >= 15){
      escreva("faça novo pedido")
    } senao se (numerodeProdutos > 15){
      escreva("produto quese esgotando")
      }
    }
  }


